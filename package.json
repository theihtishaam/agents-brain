{
  "name": "@theihtisham/agent-shadow-brain",
  "version": "7.1.4",
  "description": "Local memory, focused skills, and a visual context workspace for coding agents. Explore memories, build project-scoped context, and control briefings across Codex, Claude Code, OpenCode, and DeepSeek Harness.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "shadow-brain": "dist/cli.js",
    "asb": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "watch": "tsc --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "verify": "npm run build && npm test",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "test:package": "node tools/package-smoke.mjs",
    "test:context-eval": "node tools/evaluate-context.mjs"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "agent-memory",
    "local-first",
    "context",
    "context-management",
    "context-engineering",
    "explainable-retrieval",
    "memory-health",
    "token-budget",
    "agent-skills",
    "project-skills",
    "adaptive-memory",
    "task-workflow",
    "codex",
    "claude-code",
    "opencode",
    "deepseek-harness",
    "mcp",
    "dashboard",
    "knowledge-graph",
    "developer-tools",
    "cross-agent",
    "recall",
    "typescript",
    "cli"
  ],
  "author": "ihtisham",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "diff": "^5.2.0",
    "execa": "^9.6.1",
    "ink": "^4.4.1",
    "inquirer": "^8.2.6",
    "marked": "^18.0.2",
    "ora": "^9.3.0",
    "react": "^18.3.1",
    "simple-git": "^4.0.2",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/launch/RELEASE_CHECKLIST_v6.0.3.md",
    "docs/launch/RELEASE_NOTES_v6.0.3.md",
    "docs/launch/RELEASE_NOTES_v6.1.0.md",
    "docs/launch/RELEASE_NOTES_v6.2.0.md",
    "tools/export-resume-pack.mjs",
    "tools/record-global-memory.mjs",
    "docs/launch/RELEASE_NOTES_v7.0.0.md",
    "docs/launch/RELEASE_CHECKLIST_v7.0.0.md",
    "skills/**/*",
    "docs/launch/RELEASE_NOTES_v7.1.0.md",
    "docs/WORKFLOW_INTEGRATION.md",
    "docs/assets/*.png",
    "docs/assets/live-v7.1.4.gif",
    "docs/WORKSPACE.md",
    "docs/launch/RELEASE_NOTES_v7.2.0.md",
    "docs/launch/RELEASE_NOTES_v7.1.3.md",
    "docs/launch/RELEASE_NOTES_v7.1.4.md",
